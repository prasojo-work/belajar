# Copy this file to .env and fill in real values. Never commit .env.

# Local development (matches docker-compose.yml's Postgres)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/crud

# --- Supabase ---
# Uncomment and fill in. Prefer the connection pooler host, and keep sslmode=require.
# Session pooler (port 5432) — good for a long-running backend:
# DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
#
# Transaction pooler (port 6543) — also disable prepared statements in code,
# see the "Supabase" section of README.md:
# DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
